# --- LLM (Google AI Studio, free tier) ---
GEMINI_API_KEY=AIza...                 # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.6-flash          # primary model
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite  # retried once on quota exhaustion; empty disables
GEMINI_QA_MODEL=gemini-3.5-flash-lite  # filing Q&A answers; own per-model daily quota. Empty = use GEMINI_MODEL
GEMINI_EMBED_MODEL=gemini-embedding-001  # filing Q&A embeddings (768 dims)
MAX_FILING_CHARS=600000                # truncation cap before LLM (~150K tokens)

# --- Supabase ---
SUPABASE_URL=https://xxx.supabase.co   # Project Settings -> API
SUPABASE_KEY=sb_secret_...             # secret key (Settings > API Keys); legacy service_role JWT is disabled

# --- SEC EDGAR (no key; UA required by SEC fair-access policy) ---
SEC_USER_AGENT=SECDigest your-email@example.com

# --- CORS ---
FRONTEND_URL=http://localhost:3000     # prod: https://secdigest.tech

# --- Abuse guards (defaults are fine; override only if needed) ---
DAILY_ANALYSIS_CAP=200                 # global LLM analyses/day (protects the Gemini free quota)
MAX_REQUEST_BYTES=10000                # request body cap; the only POST body is a few short fields
